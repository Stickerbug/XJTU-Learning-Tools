{
  "manifest_version": 3,
  "name": "仙交学习工具 XJTU Learning Tools",
  "short_name": "仙交学习",
  "version": "0.4.9",
  "description": "整理思源学堂与仲英学辅课程资源，并快速查询课表、考试、成绩和空教室。",
  "permissions": ["downloads", "storage", "scripting"],
  "host_permissions": [
    "https://lms.xjtu.edu.cn/*",
    "https://rms-v5.xjtu.edu.cn/*",
    "https://media.xjtu.edu.cn/*",
    "https://review-class.xjtu.edu.cn/*",
    "https://zyxf.top/*",
    "https://jwxt.xjtu.edu.cn/*",
    "https://ywtb.xjtu.edu.cn/*",
    "https://bk-kq.xjtu.edu.cn/*",
    "https://yjs-kq.xjtu.edu.cn/*",
    "http://rg.lib.xjtu.edu.cn/*",
    "https://rg.lib.xjtu.edu.cn/*",
    "https://webvpn.xjtu.edu.cn/*",
    "https://ncard.xjtu.edu.cn/*",
    "https://message-service.xjtu.edu.cn/*",
    "https://transaction.xjtu.edu.cn/*",
    "https://reservation.xjtu.edu.cn/*",
    "https://xjbus.xjtu.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "仙交学习工具",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://lms.xjtu.edu.cn/*"],
      "js": ["content/lms.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jwxt.xjtu.edu.cn/*",
        "https://ywtb.xjtu.edu.cn/*"
      ],
      "js": ["content/campus.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bk-kq.xjtu.edu.cn/*",
        "https://yjs-kq.xjtu.edu.cn/*"
      ],
      "js": ["content/attendance.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://rg.lib.xjtu.edu.cn/*",
        "https://rg.lib.xjtu.edu.cn/*",
        "https://webvpn.xjtu.edu.cn/*"
      ],
      "js": ["content/library.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ncard.xjtu.edu.cn/*"],
      "js": ["content/card.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "manager/manager.html"
}
